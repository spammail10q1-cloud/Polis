# ---------------------------
# POLIS runtime configuration
# Copy to .env and replace values. Never commit .env.
# ---------------------------

# Required in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-secret

ENVIRONMENT=development
API_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=polis_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local development default: SQLite (zero setup).
# Docker / PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://polis:polis@localhost:5432/polis
DATABASE_URL=sqlite:///./polis.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_REGISTRATION=true
DEMO_SEED=true
DEMO_EMAIL=demo@polis.health
DEMO_PASSWORD=PolisDemo!2026
DEMO_NAME=Avery Chen

LOGIN_RATE_LIMIT_PER_MINUTE=12
ASSISTANT_RATE_LIMIT_PER_MINUTE=30

# AI. The deterministic grounded engine is the default and requires no key.
# To enable an OpenAI-compatible provider, set these values. The app validates
# citations and falls back to deterministic synthesis on failure.
LLM_PROVIDER=deterministic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30

# Demonstration privacy ledger.
FEDERATED_DP_EPSILON_PER_ROUND=0.35
FEDERATED_PRIVACY_BUDGET=8.0

# Docker Compose
POSTGRES_USER=polis
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_DB=polis
BACKEND_URL=http://127.0.0.1:8000
